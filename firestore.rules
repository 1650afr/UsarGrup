rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdminUtama() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin_utama"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active";
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdminUtama());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "uid", "displayName", "email", "status",
          "requestedRole", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.status == "pending"
        && request.resource.data.requestedRole == "anggota"
        && request.resource.data.email == request.auth.token.email;

      allow update: if isAdminUtama()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "role", "reviewedAt", "reviewedBy", "updatedAt"
        ])
        && request.resource.data.status in ["pending", "active", "rejected", "inactive"]
        && (
          !("role" in request.resource.data)
          || request.resource.data.role in [
            "anggota", "admin_upa", "pembimbing",
            "naqib", "naqibah", "murobbi", "murobbiyah",
            "muayyid", "muayyidah", "admin_utama"
          ]
        );

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
